{
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "avoid",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "node_modules",
    "pnpm-lock.yaml",
    ".env",
    ".env.local",
    "*.gguf",
    "docs/.vitepress/cache",
    "docs/.vitepress/dist"
  ]
}
