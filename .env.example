REIKA_BASE_URL=http://localhost:11434/v1
REIKA_MODEL=qwen2.5-coder:7b
REIKA_API_KEY=no-key
REIKA_MAX_TURNS=12
# Optional: additional named profiles. List comma-separated, then define
# REIKA_<NAME>_MODEL / _BASE_URL / _API_KEY for each. Switch at runtime with /model <name>.
# REIKA_PROFILES=kimi,gpt4
# REIKA_KIMI_MODEL=kimi-k2.6
# REIKA_KIMI_BASE_URL=https://api.moonshot.ai/v1
# REIKA_KIMI_API_KEY=sk-...
# Character budget for the repo-map block in the system prompt.
# Drop to ~1000 for tiny local models, raise to 6000+ for cloud models with large context.
REIKA_REPO_MAP_BUDGET=3200
# Skip the approval prompt for edit/write tool calls. Useful for trusted runs and evals.
REIKA_AUTO_APPROVE=false
# Optional: model/server for subagent calls. Falls back to the main model when unset.
REIKA_SUBAGENT_MODEL=
REIKA_SUBAGENT_BASE_URL=
REIKA_SUBAGENT_API_KEY=
# Max iterations a subagent can run before bailing.
REIKA_SUBAGENT_MAX_TURNS=6
# Optional: enables `search` + `fetch_url` tools. Pick ONE of the two providers below.
# SearXNG (self-hosted, local-first). Takes precedence over Tavily if both are set.
REIKA_SEARXNG_URL=
# Tavily (cloud, AI-optimized). Free tier 1000 req/mo at https://tavily.com.
REIKA_TAVILY_API_KEY=
