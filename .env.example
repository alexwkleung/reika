REIKA_BASE_URL=http://localhost:8080/v1
# Single model, or a comma-separated list of models all served by REIKA_BASE_URL
# (e.g. behind a model-router server). The first is the default; switch between them
# at runtime with /model <name>. Use named profiles (below) for different endpoints/keys.
REIKA_MODEL=qwen3.8-27b
REIKA_API_KEY=no-key
# Optional: tool-call rounds per user turn (default 200). A termination backstop for loops the
# detectors miss, not a cost cap — in the TUI ctrl-c is the real cap; in headless this is the only one.
# REIKA_MAX_TURNS=200
# Optional: cap response tokens (cloud cost/latency control). Unset = server default.
# REIKA_MAX_TOKENS=4096
# Optional: model context window. Denominator for the status-line `ctx` fill gauge
# (e.g. `ctx 9.9k/16k (61%)`) and what compaction, the payload cap and the generation backstop
# size themselves against. Unset = asked of the endpoint at startup (#417): llama.cpp reports the
# slot's `n_ctx` on `/v1/models`, vLLM its `max_model_len`; the number is floored to the thousand
# (24576 → 24000). A server that reports nothing (Ollama, OpenAI, a bare router) leaves it
# unset — the gauge shows absolute tokens and nothing is capped — so set it here for those.
# REIKA_CONTEXT_WINDOW=24000
# Optional: how many recent tool-call rounds keep their reasoning in context (default 2).
# 1 = leanest (only the active round); raise it so a thinking model keeps its
# chain-of-thought and doesn't re-derive across rounds, at a token cost.
# REIKA_REASONING_ROUNDS=2
# Optional: generation room (tokens) reserved from the context window (default 2048).
# One number drives the per-turn max_tokens backstop, the fit-to-window payload reserve,
# and the compaction trigger — so a spiraling small/quantized model can't run to the
# context end, and compaction fires early enough to leave room to actually respond.
# Sizing: reasoning-OFF models need ~2048 (a tool call + brief prose); reasoning-ON
# thinking models want 6144–8192 of think-room before the call. Floored at 256.
# On a 16k window with reasoning ON, set 6144.
REIKA_MIN_GEN_TOKENS=6144
# Optional: additional named profiles. List comma-separated, then define
# REIKA_<NAME>_MODEL / _BASE_URL / _API_KEY for each. Switch at runtime with /model <name>.
# _MAX_TOKENS / _CONTEXT_WINDOW / _MIN_GEN_TOKENS are also per-profile (fall back to the
# defaults above) — e.g. a 16k thinking profile can carry its own larger reserve. _MODEL takes
# a comma-separated list like REIKA_MODEL: the first is the profile's model, the rest switch
# with /model <name> on the same connection.
# REIKA_PROFILES=kimi
# REIKA_KIMI_MODEL=kimi-k2.6
# REIKA_KIMI_BASE_URL=https://api.moonshot.ai/v1
# REIKA_KIMI_API_KEY=sk-...
# REIKA_KIMI_CONTEXT_WINDOW=16384
# REIKA_KIMI_MIN_GEN_TOKENS=6144
# A hosted router beside the local default, switched to with `/model go`. OpenCode Go needs a
# session id on every request; reika sends one on every keyed request (`x-session-id`,
# provider/transport.ts).
# REIKA_PROFILES=go
# REIKA_GO_MODEL=deepseek-v4.1-flash,muse-spark-1.3-contributor
# REIKA_GO_BASE_URL=https://opencode.ai/zen/go/v1
# REIKA_GO_API_KEY=...
# No _CONTEXT_WINDOW needed: each model's window and output cap come from the models.dev catalog
# (provider/modellimits.ts), per model on every /model switch. Set one only to override it.
# Character budget for the repo-map block in the system prompt.
# Drop to ~1000 for tiny local models, raise to 6000+ for cloud models with large context.
REIKA_REPO_MAP_BUDGET=6000
# Approval mode: safe (default — ordinary edits/commands auto-run, dangerous commands and
# out-of-project writes still prompt), off (confirm everything), bypass (never prompt).
# Leave unset to keep /approvals as a session toggle; an explicit safe/bypass shadows it.
# REIKA_AUTO_APPROVE=safe
# Unattended TUI: whatever the approval mode would prompt for is declined instead (the model is
# told nobody was there to approve), and ask_user is not offered — for leaving a long turn to
# grind while you're away or overnight. Headless (-p) always behaves this way.
# REIKA_UNATTENDED=1
# Mode the session starts in: agent (default), plan, or vibe. Unrecognized values
# fall back to agent. REIKA_PLAN_EXPERIMENT=1 is the legacy alias for plan. The mode the
# last session ended in (~/.config/reika/state.json) overrides this file's value; set it on
# the command line (REIKA_DEFAULT_MODE=plan reika) to override the saved one.
# REIKA_DEFAULT_MODE=agent
# Optional: model/server for subagent calls. Falls back to the main model when unset.
REIKA_SUBAGENT_MODEL=
REIKA_SUBAGENT_BASE_URL=
REIKA_SUBAGENT_API_KEY=
# Subagent round budget. The LAST round is the report round — tools withdrawn, report demanded —
# so a subagent always hands something back. Keep it tighter than REIKA_MAX_TURNS: a subagent's
# job is to be bounded, and under aging a loose cap is a place to wander (observed: 90 minutes).
REIKA_SUBAGENT_MAX_TURNS=8
# Optional: vision model for pasted/dragged-in images (#130). When set, images are described by
# this model instead of going through system OCR; the description is attached as text, so the
# main model can stay text-only. Used for nothing else. Server/key fall back to the main ones.
REIKA_VISION_MODEL=
REIKA_VISION_BASE_URL=
REIKA_VISION_API_KEY=
# How a pasted image reaches the model. describe (the default) reads it into text first with the
# vision model above or system OCR. native hands the bytes to the model itself, as an OpenAI
# multimodal image part, for a model that can already see — llama.cpp mtmd, Ollama and vLLM all
# serve VL models this way. Per-profile too (REIKA_<NAME>_VISION), because it is a property of the
# model: keep the local default on describe and set native on the profile that can see. Native
# sends the image once, for the turn it was pasted in; history keeps a short "not transcribed" note
# in its place, so the model can ask for a re-paste but cannot look again later.
REIKA_VISION=describe
# Optional: enables the `search` tool via a self-hosted SearXNG instance (local-first, no
# third-party tool-use APIs). Leave unset to run without web search — `fetch_url` still
# registers, since fetching a known URL needs no provider.
REIKA_SEARXNG_URL=
# Optional: drive a real Chrome over CDP for web search instead of SearXNG (#235). Takes priority
# when both are set. Needs Chrome or Chromium installed; launches a separate backgrounded instance
# on its own profile (~/.config/reika/chrome), reattaches to it across searches, and shuts it down
# after ten idle minutes. REIKA_CHROME_PATH overrides binary discovery, REIKA_CDP_PORT the port.
REIKA_CDP_SEARCH=
REIKA_CDP_PORT=9222
REIKA_CHROME_PATH=
# Per-user-turn caps for the search + fetch_url tools. Prevent runaway loops
# from hammering SearXNG (and the upstream engines it proxies through).
# Defaults: 3 searches, 5 fetches per turn.
# REIKA_MAX_SEARCHES_PER_TURN=3
# REIKA_MAX_FETCHES_PER_TURN=5
# Bounds on a single bash command, ms. The ceiling is wall-clock (default 30 min — a slow
# build or a full test suite); idle kills a command that has written nothing for that long
# (default 5 min — a server, a watcher, a prompt waiting on input). 0 disables either.
# REIKA_BASH_TIMEOUT_MS=1800000
# REIKA_BASH_IDLE_MS=300000
# Post-edit typecheck gate: after a turn's edits, reika runs the project's own tsc once more and,
# if it finds errors the edits introduced, sends the model back to fix them (bounded retries). On
# by default for TypeScript projects, and self-disabling where there is no tsconfig.json or no
# local tsc in node_modules — so it costs nothing in other languages. `0` turns the whole feature
# off — the baseline capture, the re-check, and the send-backs — for a project that verifies types
# its own way, or finds a second whole-program tsc per turn too slow.
# REIKA_TYPECHECK=0
# Local sandbox for shell commands (macOS only, on by default). Uses the system's own
# sandbox-exec — Seatbelt — so there is no dependency to bundle and nothing that can change
# under us. Writes are confined to the working directory, temp and cache dirs; network is denied except
# loopback (so a local model server, or a test suite's own listener, still works) and an
# unflagged `git`/`gh` read (`gh pr view`, `git fetch` — what the shipped /issue and /review
# skills open with).
#
# The rule is one sentence: a command the danger scan flags prompts first, and a human-cleared
# command runs UNSANDBOXED — which is what lets `npm install` / `git push` / a `curl | sh`
# through without a proxy layer, since those are exactly the commands that need the network and
# exactly the ones you just approved. Everything else runs sandboxed, including a clean command
# you confirmed under REIKA_AUTO_APPROVE=off. Under `bypass` there is no prompt to fall back on,
# so every command is sandboxed and a flagged one keeps the network deny.
#
# What it does NOT do: reads stay open everywhere, cwd included. A blocklist of secret paths is
# incomplete by construction, so this is containment against a confused model rather than a
# confidentiality boundary against a determined one.
#
# On Linux this reports unavailable and behaves exactly as before: bubblewrap has no port-level
# network filtering, and --unshare-net gives the child its own loopback that cannot reach the
# host's model server. Shipping that needs a proxy layer; this does not.
# REIKA_SANDBOX=0
# Session auto-save (#1): each TUI session is saved, unredacted, under
# ~/.config/reika/history/projects/<project>/ as it runs, and /resume lists them. 0 disables it.
# REIKA_AUTOSAVE=0
# Busy indicator words: while the model works, "Working…" rotates through garden and perfumery verbs
# (Blooming…, Distilling…). Harness states like Typechecking keep their wording. 0 keeps "Working…".
# REIKA_WORKING_WORDS=0
# Preferred languages for OCR of pasted images (ctrl-v), BCP-47, comma-separated.
# Defaults to the platform recognizer's own default (en-US). Windows uses only the first.
# REIKA_OCR_LANGS=en-US,ja-JP
# Optional: directory of *.md skill files. Each file becomes a slash command.
# Defaults to ~/.config/reika/skills when unset. <cwd>/.reika/skills/ shadows on collision.
# REIKA_SKILLS_DIR=~/.config/reika/skills
# Fetch http(s) URLs pasted into a prompt before the turn runs (2 max, 8k chars each), so the
# model reads the page instead of guessing. A link the prompt is ABOUT (short prompt, link at the
# start or end or after a read verb: `read https://…`) is fetched without asking. One that merely
# appears — inside a pasted error, a log line — depends on the mode (#448). Default `ask`: the TUI
# asks in a two-row confirm; headless leaves it and says so. `apply` (also `1`): headless fetches
# it too (private hosts still refused), the TUI still asks. `0`/`off`: fetch nothing (airgapped).
# A link with credentials in it (https://user:pass@host) is never fetched in any mode.
# REIKA_PASTE_FETCH=0

# Plan→agent handoff distillation: folds the plan-mode exploration into one digest at the boundary,
# keeping the request and the plan verbatim. On by default since 2026-09-19; `=0` is the baseline.
# REIKA_PLAN_HANDOFF=0

# Experimental flags. 
# For now they are necessary to be toggled on for a better experience.
# In the near future these will be default in Reika once they are further tested.
REIKA_PLAN_VERIFY=1
REIKA_VERBATIM_ABORT=1
REIKA_LOGIT_RECOVERY=1
REIKA_CONVERGE_RETRY=1
REIKA_PLAN_ALIGN=1
# Read-first edit gate: the first edit to a file whose bytes are not in the model's context is held
# back once with a directive to read it. On by default since 2026-09-23 — worst case is one extra
# round per file per turn, and it is fail-open. `=0` is the baseline arm; under REIKA_DEBUG each
# bounce logs `would-land=yes|no` (did the gate cost a round, or catch a blind edit).
# REIKA_READ_FIRST=0
# Reasoning-loop break: acts on cross-round rumination (plan force-write; agent ledger → withdrawal →
# terminal stop). On by default since 2026-09-24; `=0` is the baseline arm. Detection always runs.
# REIKA_REASONING_LOOP=0
# URL grounding: fetches http(s) URLs an edit/write introduces (and a finalized plan names) and tells
# the model which ones are dead. Off by default because it sends requests nobody asked for; secret-
# bearing URLs, internal names and private addresses are never fetched, and it leaves the last two
# fetch slots of a turn to the model. Useful for CDN-heavy work, where a hallucinated version 404s.
# REIKA_URL_GROUNDING=1
# Read-only `bash` in plan (and vibe) mode: commands a strict allowlist classifier can prove
# read-only (`grep … | head`, `find`, `wc -l`, pipelines of them) run; anything that could write or
# run something else is refused with the rule stated. On by default since 2026-09-18 — plan mode is
# agent mode minus mutation, and the classifier, not the tool's absence, is what keeps it read-only.
# `=0` is the baseline arm: it takes the tool out and the plan prompt reverts to its pre-#109 text.
# REIKA_PLAN_BASH=0
# The mid-session subagent trigger: a grep/glob spanning several files, when reading them would
# cross the compaction threshold, gets a footer pointing at subagent. On by default since
# 2026-09-19 (it needs a known context window to fire at all; `=0` is the baseline). Preferred over
# REIKA_SUBAGENT_NUDGE (round-0 routing on request shape), which measured over-eager on a single
# slot: it pays the KV eviction and a full subagent run even when the parent had room, and lost
# the A/B to REIKA_COMPACTION_REPORT alone. Leave the nudge off unless the window is small enough
# (8–12k) that round 0 is itself a pressure condition.
# REIKA_SUBAGENT_PRESSURE=0
# REIKA_SUBAGENT_NUDGE=1
# Default `ask`: a strongly matched skill (command-shaped prompt: `review pr 420`) opens a two-row
# confirm over the input, send-as-typed selected, Enter answers; headless sends the prompt as
# typed. `apply` (also `1`) lets headless apply a strong match without asking, on prompts of 12
# words or fewer — the TUI still asks. `off` leaves only the hint line.
# REIKA_SKILL_AUTO=apply
# REIKA_WARM=1
# On by default since 2026-09-18. Collapses a byte-identical repeat of an earlier tool result to a
# short stub. Bypassed whenever REIKA_PREFIX_STABLE is active (see below), so with a context window
# set it changes nothing; it reaches the no-window and PREFIX_STABLE=0 setups, where every older
# payload is already a summary and the repeats are the whole trail. Set 0 for the baseline arm.
# REIKA_DEDUP_PAYLOADS=0
# An aged tool result serializes to its summary alone — `Ran: gh issue view 224 (505 bytes output)`
# — which reads to a model as something it already saw and handled, not as content that is gone. It
# then answers from memory of it. This adds one line per request saying those summaries are holes,
# a context limit rather than a failed command, and re-runnable. One line rather than one per
# message: per-message it measured ~19% of a long turn's request, and it moved the compaction
# trigger and the payload cap at the same time. Emitted only when something really was dropped, so
# it can never claim a loss that did not happen. On by default: a single-variable A/B on
# `/review 225` split the way the feature predicts — the baseline reconstructed a dropped diff from
# memory, the ledger arm said "the output got dropped, let me re-run it" — and the feared re-fetch
# loop never showed. `=0` is the A/B baseline. The effect shows up in transcripts, not counters
# (`dup-aged` cannot measure it: read-trace only records the `read` tool, and a `/review` turn
# fetches everything through `bash`).
# REIKA_DROPPED_LEDGER=0

# The `ask_user` tool: the model can put ONE multiple-choice question to you mid-turn and wait,
# rather than guessing when what it has read contradicts what you asked for. You pick an option,
# add a note to one (tab), or type your own answer; the answer is then pinned so it can't age out
# of context. On by default. Set 0 to remove the tool — which also removes the agent prompt's line
# about asking, since that keys off the tool list, so off is a byte-identical prompt.
# REIKA_ASK=0

# Substitute <user>/<email> for your own git name/email and GitHub/HF account slug in the
# scrollback and in saved transcripts. Display only — the model still sees everything. Off by
# default: normally you want your own handle visible, and it costs a few git calls at startup.
#REIKA_ANON=1
# Saves an over-cap grep/glob/bash result to a temp file and points the inline page at it, so the
# model can `read`/`grep` the rest instead of re-running the search. Adds no tool; fail-open.
# Benched on a 2300-file monorepo: `**/*.ts` matched 560 files whose 200-path page covered 3 of 5
# packages, and the model recovered a path from an omitted one through the artifact. That failure
# is invisible on a small repo, which is why this is on by default rather than opt-in. Set 0 to
# disable (that is also how the A/B baseline is spelled).
# REIKA_SPILL=0
# Measurement only, off by default: appends one JSON line per over-cap tool result (and per call
# that opens a saved artifact) to ~/.config/reika/spill-stats.jsonl. Records sizes and tool names,
# never output. This is the only way to answer how often over-cap results actually happen in real
# use — an eval can show the model follows a locator, not what share of a week's bash calls exceed
# 64KB. Leave it on for a week, then read the file; nothing else changes while it runs.
# REIKA_SPILL_STATS=1
# REIKA_SPILL_STATS_FILE=/path/to/collect.jsonl
# On by default whenever REIKA_CONTEXT_WINDOW is set (#181: flag-off, the prefix diverges from
# round 2 of every tool-using turn, and one mid-context edit re-prefilled 8453 tokens — 7.9 min
# at 22.9 tok/s on an M2 — where an append was 25 tokens). Inactive without a window. While on,
# REIKA_DEDUP_PAYLOADS is bypassed (a dedup stub flipping on a later duplicate would rewrite
# mid-history bytes — the exact prefix-cache invalidation this mode exists to prevent). Set 0
# for the per-round aging baseline (that is also how the A/B baseline arm is spelled).
# REIKA_PREFIX_STABLE=0
# Measurement only, and off by default unlike the flags above: ask the engine for per-token
# logprobs so the REIKA_DEBUG `entropy` lines report the model's real predictive entropy
# instead of the empirical entropy of its own output. Needs REIKA_DEBUG (the log is the only
# consumer) and costs a materially larger streamed payload — top-k candidates on every token.
# Leaving it off keeps the per-round entropy/KL drift lines, just measured from the text.
# A backend that rejects the fields is retried once without them, so this can't cost a turn.
# REIKA_ENTROPY=1
# EXPERIMENT (#284): when generation is cut off at the token limit mid-thought, carry the
# model's own work forward instead of discarding it and asking it to start over. The partial
# is promoted into the content channel (a Qwen-family template renders prior-turn
# reasoning_content as nothing, which is why the old retry lost it), trimmed to a tail — a
# truncated block's conclusion sits at its END — and followed by a resume nudge. Gated on the
# repetition ratio, so a genuinely degenerate block is still discarded. On by default: a live
# run carried 3/3 truncations with the model resuming its own thread each time (#285), and the
# failure mode is bounded — a refused carry is exactly the previous behavior. Note it changes
# what a request carries, so set `=0` for a run that is measuring context/eviction (#264).
# REIKA_CONTINUE=0
# How much of the cut-off block comes back, in chars (default 6000 ≈ 1500 tokens). The tail is
# the coherence knob; REIKA_CONTINUE_MAX is the burn knob. They are independent — a larger tail
# does not make a runaway more likely.
# REIKA_CONTINUE_TAIL_CHARS=6000
# Consecutive continuations allowed without progress, where progress is a tool call or a
# committed answer (default 3). Resets on progress, so there is no ceiling on how many times a
# session may continue in total — only on continuing without producing anything.
# REIKA_CONTINUE_MAX=3
# Absolute reasoning-length backstop in chars (default 32000 ≈ 8000 tokens), the cut that fires
# regardless of repetition ratio. A MEASUREMENT affordance: the ceiling branch is otherwise
# unreachable in a bench, since a model must produce 32000 chars twice in a row with no tool call
# in between. Lower it (e.g. 3000) with REIKA_CONTINUE_MAX=1 to drive a ceiling cut and then a
# count refusal in minutes, so both arms of an A/B run the SAME build and only the flag differs.
# Leave unset for any run that is measuring something else.
# REIKA_REASONING_CEIL=32000
