REIKA_BASE_URL=http://localhost:8080/v1
# Single model, or a comma-separated list of models all served by REIKA_BASE_URL
# (e.g. behind a model-router server). The first is the default; switch between them
# at runtime with /model <name>. Use named profiles (below) for different endpoints/keys.
REIKA_MODEL=qwen3.8-27b
REIKA_API_KEY=no-key
REIKA_MAX_TURNS=500
# Optional: cap response tokens (cloud cost/latency control). Unset = server default.
# REIKA_MAX_TOKENS=4096
# Optional: model context window. Denominator for the status-line `ctx` fill gauge
# (e.g. `ctx 9.9k/16k (61%)`). Unset = gauge shows absolute tokens with no percentage.
REIKA_CONTEXT_WINDOW=24000
# Optional: how many recent tool-call rounds keep their reasoning in context (default 2).
# 1 = leanest (only the active round); raise it so a thinking model keeps its
# chain-of-thought and doesn't re-derive across rounds, at a token cost.
# REIKA_REASONING_ROUNDS=2
# Optional: generation room (tokens) reserved from the context window (default 2048).
# One number drives the per-turn max_tokens backstop, the fit-to-window payload reserve,
# and the compaction trigger — so a spiraling small/quantized model can't run to the
# context end, and compaction fires early enough to leave room to actually respond.
# Sizing: reasoning-OFF models need ~2048 (a tool call + brief prose); reasoning-ON
# thinking models want 6144–8192 of think-room before the call. Floored at 256.
# On a 16k window with reasoning ON, set 6144.
REIKA_MIN_GEN_TOKENS=6144
# Optional: additional named profiles. List comma-separated, then define
# REIKA_<NAME>_MODEL / _BASE_URL / _API_KEY for each. Switch at runtime with /model <name>.
# _MAX_TOKENS / _CONTEXT_WINDOW / _MIN_GEN_TOKENS are also per-profile (fall back to the
# defaults above) — e.g. a 16k thinking profile can carry its own larger reserve.
# REIKA_PROFILES=kimi
# REIKA_KIMI_MODEL=kimi-k2.6
# REIKA_KIMI_BASE_URL=https://api.moonshot.ai/v1
# REIKA_KIMI_API_KEY=sk-...
# REIKA_KIMI_CONTEXT_WINDOW=16384
# REIKA_KIMI_MIN_GEN_TOKENS=6144
# Character budget for the repo-map block in the system prompt.
# Drop to ~1000 for tiny local models, raise to 6000+ for cloud models with large context.
REIKA_REPO_MAP_BUDGET=6000
# Skip the approval prompt for edit/write tool calls. Useful for trusted runs and evals.
REIKA_AUTO_APPROVE=false
# Mode the session starts in: agent (default), plan, or vibe. Unrecognized values
# fall back to agent. REIKA_PLAN_EXPERIMENT=1 is the legacy alias for plan.
# REIKA_DEFAULT_MODE=agent
# Optional: model/server for subagent calls. Falls back to the main model when unset.
REIKA_SUBAGENT_MODEL=
REIKA_SUBAGENT_BASE_URL=
REIKA_SUBAGENT_API_KEY=
# Max iterations a subagent can run before bailing.
REIKA_SUBAGENT_MAX_TURNS=500
# Optional: enables the `search` tool via a self-hosted SearXNG instance (local-first, no
# third-party tool-use APIs). Leave unset to run without web search — `fetch_url` still
# registers, since fetching a known URL needs no provider.
REIKA_SEARXNG_URL=
# Optional: drive a real Chrome over CDP for web search instead of SearXNG (#235). Takes priority
# when both are set. Needs Chrome or Chromium installed; launches a separate backgrounded instance
# on its own profile (~/.config/reika/chrome), reattaches to it across searches, and shuts it down
# after ten idle minutes. REIKA_CHROME_PATH overrides binary discovery, REIKA_CDP_PORT the port.
REIKA_CDP_SEARCH=
REIKA_CDP_PORT=9222
REIKA_CHROME_PATH=
# Per-user-turn caps for the search + fetch_url tools. Prevent runaway loops
# from hammering SearXNG (and the upstream engines it proxies through).
# Defaults: 3 searches, 5 fetches per turn.
# REIKA_MAX_SEARCHES_PER_TURN=3
# REIKA_MAX_FETCHES_PER_TURN=5
# Wall-clock timeout for a single bash command, ms. Raise for slow builds/installs;
# lower to fail hung commands faster. Default 300000 (5 min).
# REIKA_BASH_TIMEOUT_MS=300000
# Preferred languages for OCR of pasted images (ctrl-v), BCP-47, comma-separated.
# Defaults to the platform recognizer's own default (en-US). Windows uses only the first.
# REIKA_OCR_LANGS=en-US,ja-JP
# Optional: directory of *.md skill files. Each file becomes a slash command.
# Defaults to ~/.config/reika/skills when unset. <cwd>/.reika/skills/ shadows on collision.
# REIKA_SKILLS_DIR=~/.config/reika/skills
# Fetch http(s) URLs pasted into a prompt before the turn runs (2 max, 8k chars each), so the
# model reads the page instead of guessing. Set 0 on an airgapped machine. Default on.
# REIKA_PASTE_FETCH=0

# Experimental flags. 
# For now they are necessary to be toggled on for a better experience.
# In the near future these will be default in Reika once they are further tested.
REIKA_PLAN_HANDOFF=1
REIKA_REASONING_LOOP=1
REIKA_PLAN_VERIFY=1
REIKA_VERBATIM_ABORT=1
REIKA_URL_GROUNDING=1
REIKA_LOGIT_RECOVERY=1
REIKA_CONVERGE_RETRY=1
REIKA_PLAN_ALIGN=1
REIKA_PLAN_BASH=1
REIKA_READ_FIRST=1
REIKA_SKILL_AUTO=1
REIKA_WARM=1
REIKA_DEDUP_PAYLOADS=1
# An aged tool result serializes to its summary alone — `Ran: gh issue view 224 (505 bytes output)`
# — which reads to a model as something it already saw and handled, not as content that is gone. It
# then answers from memory of it. This adds one line per request saying those summaries are holes,
# a context limit rather than a failed command, and re-runnable. One line rather than one per
# message: per-message it measured ~19% of a long turn's request, and it moved the compaction
# trigger and the payload cap at the same time. Emitted only when something really was dropped, so
# it can never claim a loss that did not happen. Off in code, on here like the other experiments —
# the effect shows up in transcripts rather than in counters, and at small n, so `=0` is the A/B
# baseline. (`dup-aged` cannot measure it: read-trace only records the `read` tool, and a `/review`
# turn fetches everything through `bash`.)
REIKA_DROPPED_LEDGER=1

# The `ask_user` tool: the model can put ONE multiple-choice question to you mid-turn and wait,
# rather than guessing when what it has read contradicts what you asked for. You pick an option,
# add a note to one (tab), or type your own answer; the answer is then pinned so it can't age out
# of context. On by default. Set 0 to remove the tool — which also removes the agent prompt's line
# about asking, since that keys off the tool list, so off is a byte-identical prompt.
# REIKA_ASK=0

# Substitute <user>/<email> for your own git name/email and GitHub/HF account slug in the
# scrollback and in saved transcripts. Display only — the model still sees everything. Off by
# default: normally you want your own handle visible, and it costs a few git calls at startup.
#REIKA_ANON=1
# Saves an over-cap grep/glob/bash result to a temp file and points the inline page at it, so the
# model can `read`/`grep` the rest instead of re-running the search. Adds no tool; fail-open.
# Benched on a 2300-file monorepo: `**/*.ts` matched 560 files whose 200-path page covered 3 of 5
# packages, and the model recovered a path from an omitted one through the artifact. That failure
# is invisible on a small repo, which is why this is on by default rather than opt-in. Set 0 to
# disable (that is also how the A/B baseline is spelled).
# REIKA_SPILL=0
# Measurement only, off by default: appends one JSON line per over-cap tool result (and per call
# that opens a saved artifact) to ~/.config/reika/spill-stats.jsonl. Records sizes and tool names,
# never output. This is the only way to answer how often over-cap results actually happen in real
# use — an eval can show the model follows a locator, not what share of a week's bash calls exceed
# 64KB. Leave it on for a week, then read the file; nothing else changes while it runs.
# REIKA_SPILL_STATS=1
# REIKA_SPILL_STATS_FILE=/path/to/collect.jsonl
# Needs REIKA_CONTEXT_WINDOW. While on, REIKA_DEDUP_PAYLOADS is bypassed (a dedup stub
# flipping on a later duplicate would rewrite mid-history bytes — the exact prefix-cache
# invalidation this mode exists to prevent).
REIKA_PREFIX_STABLE=1
# Measurement only, and off by default unlike the flags above: ask the engine for per-token
# logprobs so the REIKA_DEBUG `entropy` lines report the model's real predictive entropy
# instead of the empirical entropy of its own output. Needs REIKA_DEBUG (the log is the only
# consumer) and costs a materially larger streamed payload — top-k candidates on every token.
# Leaving it off keeps the per-round entropy/KL drift lines, just measured from the text.
# A backend that rejects the fields is retried once without them, so this can't cost a turn.
# REIKA_ENTROPY=1
