{
  "name": "reika",
  "version": "0.0.1",
  "description": "Coding agent CLI for small local models, tuned for low quantization.",
  "type": "module",
  "bin": {
    "reika": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.eval.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "eval": "tsx evals/runner.ts",
    "install:global": "npm run build && npm install -g .",
    "uninstall:global": "npm uninstall -g reika",
    "reinstall:global": "npm run uninstall:global && npm run install:global"
  },
  "dependencies": {
    "cli-highlight": "^2.1.11",
    "defuddle": "^0.18.1",
    "diff": "^9.0.0",
    "dotenv": "^16.4.5",
    "fdir": "^6.5.0",
    "ignore": "^7.0.5",
    "ink": "^5.0.1",
    "jsdom": "^27.0.1",
    "jsonrepair": "^3.14.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "picomatch": "^4.0.4",
    "react": "^18.3.1",
    "wrap-ansi": "^9.0.2"
  },
  "optionalDependencies": {
    "@napi-rs/system-ocr": "^1.1.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/jsdom": "^28.0.3",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.9.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^18.3.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
