{
  "name": "@alexwkleung/reika",
  "version": "0.1.0",
  "description": "Coding agent CLI for local and hosted models, designed around small local models first.",
  "license": "Apache-2.0",
  "author": "Alex Leung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexwkleung/reika.git"
  },
  "homepage": "https://github.com/alexwkleung/reika#readme",
  "bugs": {
    "url": "https://github.com/alexwkleung/reika/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/alexwkleung"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/alexwkleung"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/alexwkleung"
    }
  ],
  "keywords": [
    "coding-agent",
    "cli",
    "llm",
    "local-llm",
    "llama-cpp",
    "quantization",
    "mlx",
    "ai-agent"
  ],
  "type": "module",
  "bin": {
    "reika": "./dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.eval.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix-suggestions -A all -D no-unused-vars . ; oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "eval": "tsx evals/runner.ts",
    "docs:dev": "pnpm --dir docs run dev",
    "docs:build": "pnpm --dir docs run build",
    "install:global": "pnpm run build && pnpm add -g . && if command -v reika >/dev/null; then echo \"reika $(reika --version) installed at $(command -v reika)\"; else echo \"reika installed, but pnpm's global bin dir is not on your PATH (run: pnpm setup)\"; fi",
    "uninstall:global": "pnpm remove -g @alexwkleung/reika || pnpm remove -g reika",
    "reinstall:global": "pnpm run uninstall:global && pnpm run install:global",
    "prepack": "pnpm run build",
    "release:check": "scripts/release-check.sh",
    "release:verify": "tsx scripts/release-verify.ts"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "defuddle": "^0.19.4",
    "diff": "^9.0.0",
    "dotenv": "^16.4.5",
    "fdir": "^6.5.0",
    "highlight.js": "^11.12.0",
    "ignore": "^7.0.5",
    "ink": "^5.0.1",
    "jsonrepair": "^3.14.0",
    "linkedom": "^0.18.13",
    "marked": "^15.0.12",
    "picomatch": "^4.0.4",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.1.0",
    "supports-hyperlinks": "^3.2.0",
    "wrap-ansi": "^9.0.2"
  },
  "optionalDependencies": {
    "@napi-rs/system-ocr": "^1.1.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.9.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^18.3.12",
    "ink-testing-library": "^4.0.0",
    "oxfmt": "0.71.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1"
}
