{
  "name": "reika-code",
  "version": "0.0.1",
  "description": "Minimalistic coding-agent CLI tuned for small local models.",
  "type": "module",
  "bin": {
    "reika": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.eval.json",
    "eval": "tsx evals/runner.ts"
  },
  "dependencies": {
    "cli-highlight": "^2.1.11",
    "dotenv": "^16.4.5",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "openai": "^4.71.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
